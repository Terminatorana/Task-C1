rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /posts/{postId} {
      // Posts are public so visitors can search and read community content.
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.keys().hasAll([
          'type', 'title', 'searchTitle', 'tags', 'authorUid', 'authorName', 'createdAt'
        ])
        && request.resource.data.type in ['question', 'article']
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 5
        && request.resource.data.title.size() <= 120
        && request.resource.data.tags is list
        && request.resource.data.tags.size() >= 1
        && request.resource.data.tags.size() <= 3;
      allow update: if request.auth != null
        && resource.data.authorUid == request.auth.uid
        && request.resource.data.authorUid == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.authorUid == request.auth.uid;
    }

    match /users/{userId} {
      allow read, create, update: if request.auth != null
        && request.auth.uid == userId;
      allow delete: if false;
    }
  }
}
